# ────────────────────────────────────────────────────────────────────────────────
# $PEANUTS Ingester — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env.
# ────────────────────────────────────────────────────────────────────────────────

# Required: Helius API key (get from https://dev.helius.xyz)
HELIUS_API_KEY=

# Required: SPL token mint address to track
TOKEN_MINT_ADDRESS=

# Optional: SQLite database file path (default: ./data/peanuts.db)
# DB_PATH=./data/peanuts.db

# Optional: Pino log level — trace|debug|info|warn|error (default: info)
# LOG_LEVEL=info

# Optional: Max concurrent wallet history fetches (default: 3)
# Increase carefully — each adds to your Helius RPS consumption
# INGESTION_CONCURRENCY=3

# Optional: Helius API requests per second ceiling (default: 10 for free tier)
# Set to 50 if on a paid plan
# HELIUS_RPS=10

# Optional: Express API port for Phase 4 (default: 3001)
# API_PORT=3001
